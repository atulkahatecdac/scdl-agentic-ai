      "position": [
        960,
        -120
      ],
      "webhookId": "2fc49897-d1bf-4d5c-acd3-2e308ecad32f"
    },
    {
      "parameters": {
        "operation": "update",
        "table": {
          "__rl": true,
          "value": "expenses",
          "mode": "name"
        },
        "dataMode": "defineBelow",
        "columnToMatchOn": "expense_id",
        "valueToMatchOn": "={{ $('Edit Fields').item.json.expense_id }}",
        "valuesToSend": {
          "values": [
            {
              "column": "status",
              "value": "={{ $json.data.approved ? 'Approved' : 'Rejected' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e4cebb07-7a1c-4339-86a6-f6b7382110e5",
      "name": "Record Decision",
