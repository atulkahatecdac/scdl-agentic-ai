{
  "name": "M2-WF2 Expense Approval",
  "nodes": [
    {
      "parameters": {
        "content": "## M2-WF2 Expense Approval\n**Setup**\n1. Pick MySQL and Gmail credentials in every red node.\n2. Change the manager address in **Ask Manager** (manager@example.com).\n3. Claims above Rs 5,000 pause until the manager clicks Approve/Decline — open the email link on the machine running n8n.",
        "width": 480,
        "height": 260,
        "color": 5
      },
      "id": "6805ccd1-507f-4d72-9eaf-19d27ac2a036",
      "name": "Note 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -360
      ]
    },
    {
      "parameters": {
        "formTitle": "Submit an Expense Claim",
        "formDescription": "Claims up to Rs 5,000 are approved automatically.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Employee Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "requiredField": true,
              "fieldType": "email"
            },
            {
              "fieldLabel": "Amount",
              "requiredField": true,
              "fieldType": "number"
            },
            {
              "fieldLabel": "Category",
              "requiredField": true,
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Travel"
                  },
                  {
                    "option": "Meals"
                  },
                  {
                    "option": "Supplies"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Description",
              "requiredField": true,
              "fieldType": "textarea"
            }
          ]
        },
        "options": {
          "path": "expense",
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Claim received. You will get an email with the decision."
            }
          }
        }
      },
      "id": "1bd73b0a-a8f8-4330-9ce1-4147d3a560b2",
      "name": "Form Trigger",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
      "webhookId": "ec68dc72-c060-4917-bbdc-a2f44ab4c043"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "154a2743-22df-414a-90ac-b11daee61d73",
              "name": "expense_id",
              "value": "=EXP-{{ $now.toFormat('yyMMdd') }}-{{ $execution.id }}",
              "type": "string"
            },
            {
              "id": "3879ee70-be69-4fb3-bc75-c1276ffd159e",
              "name": "employee",
              "value": "={{ $json['Employee Name'] }}",
              "type": "string"
            },
            {
              "id": "61de4acf-cc34-4fae-976f-239e0af65d62",
              "name": "email",
              "value": "={{ $json.Email }}",
              "type": "string"
            },
            {
              "id": "8ad45a3d-0b44-4141-89c1-ce4dee618187",
              "name": "amount",
              "value": "={{ Number($json.Amount) }}",
              "type": "number"
            },
            {
              "id": "f627c784-270f-4ee1-9ff4-dab97f4ff8bd",
              "name": "category",
              "value": "={{ $json.Category }}",
              "type": "string"
            },
            {
              "id": "26ae263f-998e-46b8-8303-66cf37fee380",
              "name": "description",
              "value": "={{ $json.Description }}",
              "type": "string"
            },
            {
              "id": "08f6a8a2-2cab-42c6-a78d-b363208c5371",
              "name": "status",
              "value": "Pending",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "96119130-ea01-4d06-af59-291aab79b13e",
      "name": "Edit Fields",
