      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "table": {
          "__rl": true,
          "value": "expenses",
          "mode": "name"
        },
        "options": {}
      },
      "id": "8faba312-d83f-44e6-9fb2-6e3d1ea0b9cf",
      "name": "Save Claim",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c40a094a-46e6-427e-a874-176b58dbff19",
              "leftValue": "={{ $('Edit Fields').item.json.amount }}",
              "rightValue": 5000,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "cd648a94-c2c7-44c1-9828-111aa90421ae",
      "name": "Needs Approval?",
