      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Edit Fields').item.json.email }}",
        "subject": "=Expense {{ $('Edit Fields').item.json.expense_id }}: {{ $('Ask Manager').isExecuted ? ($('Ask Manager').item.json.data.approved ? 'Approved' : 'Rejected') : 'Approved' }}",
        "emailType": "html",
        "message": "=<p>Hi {{ $('Edit Fields').item.json.employee }},</p><p>Your claim of Rs {{ $('Edit Fields').item.json.amount }} ({{ $('Edit Fields').item.json.category }}) is <b>{{ $('Ask Manager').isExecuted ? ($('Ask Manager').item.json.data.approved ? 'Approved' : 'Rejected') : 'Approved' }}</b>.</p>",
        "options": {
          "appendAttribution": false
        }
      },
