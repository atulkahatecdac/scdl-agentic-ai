      "typeVersion": 2.2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "manager@example.com",
        "subject": "=Approve expense {{ $('Edit Fields').item.json.expense_id }}: Rs {{ $('Edit Fields').item.json.amount }}",
        "message": "=Employee: {{ $('Edit Fields').item.json.employee }}\nAmount: Rs {{ $('Edit Fields').item.json.amount }}\nCategory: {{ $('Edit Fields').item.json.category }}\nDescription: {{ $('Edit Fields').item.json.description }}",
        "approvalOptions": {
          "values": {
            "approvalType": "double"
          }
        },
        "options": {}
      },
      "id": "d2c8ceb8-d5e3-481e-a5ec-54603dcd8238",
      "name": "Ask Manager",
